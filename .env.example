PORT=3000

# Database — choose ONE source:
# Option A (local dev, docker-compose Postgres):
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nomenclator_db
# Option B (Neon, pooled URL used at runtime; ssl + small pool applied automatically):
# DATABASE_URL=postgres://user:pass@host-pooler.neon.tech/db
# Migrations run against the DIRECT (non-pooler) URL; DATABASE_URL_DIRECT is an accepted alias:
# DIRECT_DATABASE_URL=postgres://user:pass@host.neon.tech/db

# Vercel deploy environment (production | preview | development).
# Vercel forces NODE_ENV=production even on previews, so environment
# discrimination (e.g. Swagger gating) must go through VERCEL_ENV.
# VERCEL_ENV=development

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d
